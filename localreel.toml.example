# Example LocalReel configuration.
#
# Priority: built-in defaults < this file < LOCALREEL_* environment variables.
# Point LOCALREEL_CONFIG at a different file to use it.

[server]
host = "127.0.0.1"
port = 3001
allow_remote = false
# web_dir = "../localreel-web/dist"

[data]
# Relative paths are resolved against the program's directory (the install
# folder), so the library follows the installation. Use an absolute path to pin
# it somewhere else.
dir = "data"
# db = "data/localreel.db"

[jobs]
workers = 2
poll_interval_ms = 250
lease_secs = 60
max_attempts = 3
# Enqueue a cache_gc job on startup and every N seconds; 0 disables.
cache_gc_interval_secs = 86400

[media]
# Bare names resolve through PATH. For a portable package either point at
# bundled binaries, or set LOCALREEL_FFMPEG_DIR to the directory containing
# ffmpeg/ffprobe. Discovery also checks next to localreel.exe:
#   ffmpeg/ffprobe / ffmpeg/bin / tools/ffmpeg/bin / bin
ffmpeg = "ffmpeg"
ffprobe = "ffprobe"
probe_timeout_secs = 30
thumbnail_timeout_secs = 60
transcode_timeout_secs = 1800
cache_max_bytes = 21474836480
cache_max_age_hours = 720
# thumbnails_dir = "data/thumbnails"
# transcodes_dir = "data/transcodes"

# Sidecar storage plugins. Each package is a `.lrplug` zip with a manifest.json
# at its root; the plugin id in that manifest becomes the `kind` a source uses.
#
# [[plugins]]
# package = "plugins/webdav.lrplug"
# enabled = true
#
# [plugins.config]
# base_url = "https://nas.local/dav/library"
# username = "reader"
# password = "secret"

# How the host treats a plugin that cannot start.
#
# The default keeps the server usable: the failure is reported in Admin and in
# the plugin audit (`start.failed`), and everything else keeps working. Servers
# that would rather refuse to boot with a broken provider can opt in.
#
# [plugin_runtime]
# strict = false
# How long a stop waits for in-flight plugin requests before killing the
# process (seconds).
# stop_timeout_secs = 5

# Ask GitHub for the latest release so the Admin page can show it. The server
# never downloads or installs anything: the card links to the release page.
# Set check = false, or point feed at a mirror, on an offline network.
#
# [update]
# check = true
# feed = "https://api.github.com/repos/LocalReel/LocalReel/releases/latest"
# interval_hours = 24
